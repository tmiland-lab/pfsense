+/**
+ * Resolve every A/AAAA address for a hostname, following CNAME chains and
+ * sampling the resolver several times so a single rotating answer cannot
+ * leave the alias table incomplete. On every reload the freshly sampled
+ * answers replace the retained set in /var/db/dnscache, so addresses that
+ * dropped out of rotation are pruned from the domain instead of growing
+ * the alias table forever.
+ *
+ * DNS cost: every reload samples the resolver $samples times to collect
+ * the answers that are current right now. If sampling returns no answers
+ * at all (transient resolver failure), the previously retained set is
+ * kept so a DNS hiccup cannot wipe the alias table.
+ *
+ * Retained sets for hostnames that have not been resolved (e.g. removed
+ * from all aliases) for $prune_older_than_days days are removed.
+ */
+function resolve_alias_host_addresses($host, $samples = 3, $prune_older_than_days = 30) {
+	$all = array();
+	$previous = array();
+
+	if (is_ipaddr($host)) {
+		return array($host);
+	}
+
+	/* Load the previously observed set as a fallback for transient
+	 * resolver failures only. It is not merged into the result: every
+	 * reload replaces the retained set with the freshly sampled answers. */
+	if (is_dir("/var/db/dnscache") && is_readable("/var/db/dnscache/{$host}")) {
+		foreach (file("/var/db/dnscache/{$host}") as $line) {
+			$line = trim($line);
+			if (is_ipaddr($line) && !isset($previous[$line])) {
+				$previous[$line] = true;
+			}
+		}
+	}
+
+	/* Sample the resolver several times to collect the addresses that are
+	 * current right now; only these are kept, so stale answers are pruned. */
+	for ($i = 0; $i < $samples; $i++) {
+		foreach (resolve_host_addresses($host, array(DNS_A | DNS_AAAA), false) as $addr) {
+			if (is_ipaddr($addr) && !isset($all[$addr])) {
+				$all[$addr] = true;
+			}
+		}
+	}
+
+	/* Follow CNAME chains to their terminal addresses */
+	$stack = array($host);
+	$visited = array($host => true);
+	while (!empty($stack)) {
+		$cname = array_pop($stack);
+		foreach (resolve_host_addresses($cname, array(DNS_CNAME), false) as $target) {
+			if (!is_fqdn($target) || isset($visited[$target])) {
+				continue;
+			}
+			$visited[$target] = true;
+			$stack[] = $target;
+			foreach (resolve_host_addresses($target, array(DNS_A | DNS_AAAA), false) as $addr) {
+				if (is_ipaddr($addr) && !isset($all[$addr])) {
+					$all[$addr] = true;
+				}
+			}
+		}
+	}
+
+	if (empty($all)) {
+		/* No answers at all: keep the previous set rather than wiping the
+		 * alias table on a transient resolver failure. */
+		return array_keys($previous);
+	}
+
+	$ips = array_keys($all);
+
+	/* Persist the current set, replacing the previous one, so answers
+	 * that dropped out of rotation are pruned from the alias table. */
+	if (is_dir("/var/db/dnscache") || @mkdir("/var/db/dnscache", 0755, true)) {
+		@file_put_contents("/var/db/dnscache/{$host}", implode("\n", $ips) . "\n");
+
+		/* Prune retained sets for hostnames that have stopped resolving
+		 * (e.g. removed from every alias) so stale addresses do not linger
+		 * in the alias tables indefinitely. */
+		$stale_files = glob("/var/db/dnscache/*");
+		if (is_array($stale_files)) {
+			foreach ($stale_files as $file) {
+				$mtime = @filemtime($file);
+				if ($mtime !== false && ((time() - $mtime) > ($prune_older_than_days * 86400))) {
+					@unlink($file);
+				}
+			}
+		}
+	}
+
+	return $ips;
+}
